RewriteEngine On

# Disable Directory Browsing
Options -Indexes

# Disable sensitive files access
<FilesMatch "^\.env|\.git|composer\.(json|lock)|certdb\.sql$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Only redirect the root URL to public
RewriteRule ^$ public/ [L]

# Allow normal access to other folders/files
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ public/$1 [L]